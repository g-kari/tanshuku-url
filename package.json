{
  "name": "tanshuku-url",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "dev:frontend": "cd frontend && vite",
    "dev:all": "concurrently \"wrangler dev\" \"cd frontend && vite\"",
    "build": "npm ci --prefix frontend && npm run build --prefix frontend",
    "deploy": "npm run build && wrangler deploy",
    "db:migrate": "wrangler d1 execute tanshuku-db --file=schema.sql",
    "db:migrate:local": "wrangler d1 execute tanshuku-db --local --file=schema.sql"
  },
  "dependencies": {
    "hono": "^4.13.14"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261104.1",
    "concurrently": "^10.0.6",
    "typescript": "^7.0.2",
    "wrangler": "^4.156.1"
  }
}
